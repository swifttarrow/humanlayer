# Required — OpenAI API key for the agent's model calls
OPENAI_API_KEY=your-api-key-here

# Database (used by server and Prisma migrations)
DATABASE_URL=postgresql://humanlayer:humanlayer@localhost:5432/humanlayer_dev

# Server
PORT=3000
LEASE_DURATION_SECONDS=60
LEASE_SWEEP_INTERVAL_MS=30000

# Agent
SERVER_URL=http://localhost:3000
AGENT_ID=local-agent-1
POLL_INTERVAL_MS=5000
HEARTBEAT_INTERVAL_MS=15000
AGENT_MODEL=gpt-4.1-mini
MAX_STEPS=20
SHELL_TIMEOUT_MS=30000
