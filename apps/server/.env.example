DATABASE_URL="postgresql://humanlayer:humanlayer@localhost:5432/humanlayer_dev"
PORT=3000
LEASE_DURATION_SECONDS=60

# Default bind-mounted workspace (Docker Compose: matches volume at /workspace)
SESSION_DEFAULT_WORKDIR=/workspace

# Optional: GitHub clone + branch sessions (omit for local-files-only; requires token below)
GITHUB_TOKEN=

# Per-session GitHub clones live under this directory (shared volume with agent)
SESSION_WORKSPACE_ROOT=/workspace/sessions

RUNTIME_MODE=docker
RUNTIME_MODE_POLICY=docker_only
