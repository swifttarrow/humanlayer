{
  "name": "@humanlayer/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "prisma generate && tsc --project tsconfig.build.json",
    "typecheck": "tsc --project tsconfig.json --noEmit",
    "lint": "eslint src --ext .ts",
    "test": "vitest run",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "eval:mvp": "tsx src/evals/mvpEvalRunner.ts"
  },
  "dependencies": {
    "@humanlayer/shared": "*",
    "@prisma/client": "^5.13.0",
    "prisma": "^5.13.0",
    "express": "^4.19.2",
    "vite": "8.0.2",
    "zod": "^3.22.4",
    "@types/express": "^4.17.21",
    "@types/node": "^20.12.12"
  },
  "devDependencies": {
    "tsx": "^4.10.5",
    "vitest": "^4.1.1"
  }
}
